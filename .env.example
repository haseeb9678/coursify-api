NODE_ENV=development
APP_NAME=Coursify
PORT=4000

FRONTEND_URL=http://localhost:3000

GRAPHQL_PATH=/graphql
GRAPHQL_INTROSPECTION=true

# Database
DATABASE_URL="YOUR_NEON_POOLED_CONNECTION_STRING"
DIRECT_URL="YOUR_NEON_DIRECT_CONNECTION_STRING"

# JWT Configuration
JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret

JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
# Optional hard cap in seconds. Defaults to JWT_REFRESH_EXPIRES_IN.
# For a rolling window, use a shorter JWT_REFRESH_EXPIRES_IN than this cap.
# JWT_SESSION_MAX_AGE=604800

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Stripe Sandbox (checkout stays disabled until both Sandbox credentials are set)
PAYMENTS_ENABLED=false
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_USD_MIN_MINOR_UNITS=50
# Set the account-appropriate presentment minimum to enable PKR.
STRIPE_PKR_MIN_MINOR_UNITS=

# Cloudflare R2 Standard object storage
STORAGE_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_REGION=auto
R2_PUBLIC_BUCKET=coursify-public
R2_PRIVATE_BUCKET=coursify-private
R2_PUBLIC_URL=
R2_NAMESPACE=
R2_UPLOAD_URL_EXPIRY_SECONDS=900
R2_PRIVATE_READ_URL_EXPIRY_SECONDS=1800
R2_MAX_IMAGE_SIZE_MB=5
R2_MAX_VIDEO_SIZE_MB=500
R2_MAX_PROMO_VIDEO_SIZE_MB=100
R2_MAX_DOCUMENT_SIZE_MB=25
R2_MAX_RESOURCE_SIZE_MB=50
R2_MULTIPART_THRESHOLD_MB=100
R2_MULTIPART_PART_SIZE_MB=10
R2_STORAGE_SOFT_LIMIT_GB=8
R2_STORAGE_HARD_LIMIT_GB=9
