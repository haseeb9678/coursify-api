NODE_ENV=development
APP_NAME=Coursify
PORT=4000

FRONTEND_URL=http://localhost:3000

GRAPHQL_PATH=/graphql
GRAPHQL_INTROSPECTION=true

# Database
DATABASE_URL="YOUR_NEON_POOLED_CONNECTION_STRING"
DIRECT_URL="YOUR_NEON_DIRECT_CONNECTION_STRING"

# JWT Configuration
JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret

JWT_ACCESS_EXPIRES_IN=your_time
JWT_REFRESH_EXPIRES_IN=your_time
# Stripe Sandbox (checkout stays disabled until both Sandbox credentials are set)
PAYMENTS_ENABLED=false
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_USD_MIN_MINOR_UNITS=50
# Set the account-appropriate presentment minimum to enable PKR.
STRIPE_PKR_MIN_MINOR_UNITS=
