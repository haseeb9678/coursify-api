generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  name         String @db.VarChar(100)
  email        String @unique @db.VarChar(255)
  passwordHash String

  avatar String?

  role   UserRole   @default(STUDENT)
  status UserStatus @default(ACTIVE)

  isEmailVerified Boolean   @default(false)
  lastLoginAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  refreshSessions   RefreshSession[]
  taughtCourses     Course[]            @relation("CourseInstructor")
  createdCourses    Course[]            @relation("CourseCreator")
  courseReviews     CourseReview[]      @relation("CourseReviewer")

  heroSlidesCreated  HeroSlide[] @relation("HeroSlideCreator")
  heroSlidesUpdated  HeroSlide[] @relation("HeroSlideUpdater")
  heroSettingsEdited HeroSettings[] @relation("HeroSettingsUpdater")
  popupsCreated      PromotionalPopup[] @relation("PopupCreator")
  popupsUpdated      PromotionalPopup[] @relation("PopupUpdater")

  enrollments Enrollment[]
  lessonComments LessonComment[]
  uploadedMedia MediaAsset[]
  orders       PurchaseOrder[]
  checkoutRateLimit CheckoutRateLimit?

  @@map("users")
}

model RefreshSession {
  id               String @id @default(uuid()) @db.Uuid
  userId           String @db.Uuid
  refreshTokenHash         String
  previousRefreshTokenHash String?
  refreshRequestHash       String?
  refreshRotatedAt         DateTime?

  userAgent String?
  ipAddress String?

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  ARCHIVED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CoursePricingType {
  FREE
  PAID
}

enum LessonType {
  VIDEO
  TEXT
  PDF
}

enum LessonResourceType {
  PDF
  DOCUMENT
  LINK
  FILE
}

enum CourseReviewDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

model Category {
  id             String         @id @default(uuid()) @db.Uuid
  name           String         @db.VarChar(100)
  slug           String         @unique @db.VarChar(120)
  description    String         @db.VarChar(1000)
  iconName       String         @db.VarChar(50)
  iconColor      String         @db.VarChar(20)
  iconBackground String         @db.VarChar(20)
  imageUrl       String?
  status         CategoryStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  courses Course[]

  @@index([status])
  @@index([name])
  @@map("categories")
}

model Course {
  id                   String           @id @default(uuid()) @db.Uuid
  title                String           @db.VarChar(180)
  slug                 String           @unique @db.VarChar(200)
  shortDescription     String           @default("") @db.VarChar(500)
  description          String           @default("") @db.VarChar(10000)
  thumbnailUrl         String?
  promotionalVideoUrl  String?
  categoryId           String           @db.Uuid
  instructorId         String           @db.Uuid
  createdById          String           @db.Uuid
  level                CourseLevel      @default(BEGINNER)
  language             String           @default("English") @db.VarChar(100)
  pricingType          CoursePricingType @default(FREE)
  priceMinorUnits      Int              @default(0)
  discountedPriceMinorUnits Int?
  currency             String           @default("USD") @db.VarChar(3)
  learningOutcomes     String[]         @default([])
  requirements         String[]         @default([])
  targetAudience       String[]         @default([])
  status               CourseStatus     @default(DRAFT)
  isFeatured           Boolean          @default(false)
  submittedAt          DateTime?
  approvedAt           DateTime?
  publishedAt          DateTime?
  archivedAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  category    Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  instructor  User           @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: Restrict)
  createdBy   User           @relation("CourseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sections    CourseSection[]
  reviews     CourseReview[]
  enrollments Enrollment[]
  orders      PurchaseOrder[]

  @@index([categoryId])
  @@index([instructorId])
  @@index([createdById])
  @@index([status])
  @@index([level])
  @@index([language])
  @@index([pricingType])
  @@index([isFeatured])
  @@index([publishedAt])
  @@map("courses")
}

model CourseSection {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @db.Uuid
  title       String   @db.VarChar(180)
  description String   @default("") @db.VarChar(2000)
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons CourseLesson[]

  @@unique([courseId, position])
  @@index([courseId])
  @@map("course_sections")
}

model CourseLesson {
  id              String    @id @default(uuid()) @db.Uuid
  sectionId       String    @db.Uuid
  title           String    @db.VarChar(180)
  description     String    @default("") @db.VarChar(2000)
  type            LessonType
  content         String    @default("") @db.Text
  videoUrl        String?
  documentUrl     String?
  videoAssetId    String?   @db.Uuid
  documentAssetId String?   @db.Uuid
  durationSeconds Int?
  position        Int
  isPreview       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  section   CourseSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  resources LessonResource[]
  comments  LessonComment[]
  videoQualities LessonVideoQuality[]
  videoAsset MediaAsset? @relation("LessonVideo", fields: [videoAssetId], references: [id], onDelete: Restrict)
  documentAsset MediaAsset? @relation("LessonDocument", fields: [documentAssetId], references: [id], onDelete: Restrict)

  @@unique([sectionId, position])
  @@index([sectionId])
  @@index([videoAssetId])
  @@index([documentAssetId])
  @@map("course_lessons")
}

model LessonVideoQuality {
  lessonId String @db.Uuid
  height Int
  assetId String @db.Uuid

  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([lessonId, height])
  @@unique([lessonId, assetId])
  @@index([assetId])
  @@map("lesson_video_qualities")
}

model LessonResource {
  id        String              @id @default(uuid()) @db.Uuid
  lessonId  String              @db.Uuid
  title     String              @db.VarChar(180)
  type      LessonResourceType
  url       String
  fileName  String?             @db.VarChar(255)
  fileSize  Int?
  mediaAssetId String? @db.Uuid
  position  Int
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([lessonId, position])
  @@index([lessonId])
  @@index([mediaAssetId])
  @@map("lesson_resources")
}

enum MediaPurpose {
  COURSE_THUMBNAIL
  COURSE_PROMOTIONAL_VIDEO
  CATEGORY_IMAGE
  USER_AVATAR
  HERO_IMAGE
  HERO_MOBILE_IMAGE
  PROMOTIONAL_POPUP_IMAGE
  LESSON_VIDEO
  LESSON_DOCUMENT
  LESSON_RESOURCE
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

enum MediaStatus {
  PENDING
  READY
  FAILED
  ABORTED
  DELETING
  DELETED
}

model MediaAsset {
  id String @id @default(uuid()) @db.Uuid
  requestId String @db.Uuid
  uploadedById String? @db.Uuid
  courseScopeId String? @db.Uuid
  bucket String
  objectKey String
  stagingBucket String
  publicUrl String? @unique
  originalFileName String @db.VarChar(255)
  mimeType String
  extension String
  sizeBytes Int
  purpose MediaPurpose
  visibility MediaVisibility
  status MediaStatus @default(PENDING)
  multipartId String?
  partSize Int?
  expiresAt DateTime
  stagingPending Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  uploadedAt DateTime?
  deletedAt DateTime?

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  lessonVideos CourseLesson[] @relation("LessonVideo")
  lessonVideoQualities LessonVideoQuality[]
  lessonDocuments CourseLesson[] @relation("LessonDocument")
  lessonResources LessonResource[]

  @@unique([uploadedById, requestId])
  @@unique([bucket, objectKey])
  @@index([status, expiresAt])
  @@index([createdAt, id])
  @@map("media_assets")
}

model MediaRequestLimit {
  key String @id
  windowStart DateTime
  requests Int

  @@map("media_request_limits")
}

model LessonComment {
  id        String   @id @default(uuid()) @db.Uuid
  lessonId  String   @db.Uuid
  authorId  String   @db.Uuid
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now())

  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([lessonId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId])
  @@map("lesson_comments")
}

model CourseReview {
  id             String               @id @default(uuid()) @db.Uuid
  courseId       String               @db.Uuid
  reviewerId     String               @db.Uuid
  decision       CourseReviewDecision
  feedback       String               @db.VarChar(5000)
  previousStatus CourseStatus
  newStatus      CourseStatus
  createdAt      DateTime             @default(now())

  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  reviewer User   @relation("CourseReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([courseId])
  @@index([reviewerId])
  @@index([createdAt])
  @@map("course_reviews")
}

enum WebsiteContentStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum HeroImagePosition {
  CENTER
  CENTER_UP
  LEFT
  RIGHT
  TOP
  BOTTOM
}

enum PopupLayout {
  CENTERED
  IMAGE_LEFT
  IMAGE_TOP
  TEXT_ONLY
}

enum PopupTrigger {
  ON_PAGE_LOAD
  AFTER_DELAY
}

enum PopupFrequency {
  ONCE_PER_SESSION
  ONCE_PER_VISITOR
  ONCE_PER_DAY
  EVERY_VISIT
  CUSTOM_INTERVAL
}

enum PopupAudience {
  ALL_VISITORS
  GUESTS_ONLY
  AUTHENTICATED_USERS
}

enum PopupPageTarget {
  HOMEPAGE_ONLY
  ALL_PUBLIC_PAGES
  COURSE_CATALOG
  SPECIFIC_PATHS
}

model HeroSlide {
  id                String @id @default(uuid()) @db.Uuid
  internalName      String @db.VarChar(100)
  eyebrow           String @default("") @db.VarChar(60)
  title             String @default("") @db.VarChar(110)
  description       String @default("") @db.VarChar(260)
  imageUrl          String?
  mobileImageUrl    String?
  imageAlt          String @default("") @db.VarChar(160)
  imagePosition     HeroImagePosition @default(CENTER)
  primaryCtaLabel   String @default("") @db.VarChar(40)
  primaryCtaHref    String?
  secondaryCtaLabel String @default("") @db.VarChar(40)
  secondaryCtaHref  String?
  position          Int
  status            WebsiteContentStatus @default(DRAFT)
  startsAt          DateTime?
  endsAt            DateTime?
  createdById       String? @db.Uuid
  updatedById       String? @db.Uuid
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  createdBy User? @relation("HeroSlideCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("HeroSlideUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([position, id])
  @@index([status, startsAt, endsAt])
  @@map("website_hero_slides")
}

model HeroSettings {
  id                   Int @id @default(1)
  isEnabled            Boolean @default(true)
  autoplayEnabled      Boolean @default(true)
  autoplayDelayMs      Int @default(6000)
  loopEnabled          Boolean @default(true)
  showNavigationArrows Boolean @default(true)
  showPaginationDots   Boolean @default(true)
  pauseOnHover         Boolean @default(true)
  pauseOnFocus         Boolean @default(true)
  updatedById          String? @db.Uuid
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  updatedBy User? @relation("HeroSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("website_hero_settings")
}

model PromotionalPopup {
  id                String @id @default(uuid()) @db.Uuid
  internalName      String @db.VarChar(100)
  title             String @default("") @db.VarChar(110)
  description       String @default("") @db.VarChar(500)
  imageUrl          String?
  imageAlt          String @default("") @db.VarChar(160)
  layout            PopupLayout @default(CENTERED)
  primaryCtaLabel   String @default("") @db.VarChar(40)
  primaryCtaHref    String?
  secondaryCtaLabel String @default("") @db.VarChar(40)
  secondaryCtaHref  String?
  status            WebsiteContentStatus @default(DRAFT)
  priority          Int @default(0)
  triggerType       PopupTrigger @default(ON_PAGE_LOAD)
  delaySeconds      Int @default(5)
  displayFrequency  PopupFrequency @default(ONCE_PER_SESSION)
  repeatAfterHours  Int?
  audience          PopupAudience @default(ALL_VISITORS)
  pageTarget        PopupPageTarget @default(HOMEPAGE_ONLY)
  targetPaths       String[] @default([])
  startsAt          DateTime?
  endsAt            DateTime?
  createdById       String? @db.Uuid
  updatedById       String? @db.Uuid
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  createdBy User? @relation("PopupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("PopupUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status, startsAt, endsAt])
  @@index([priority, createdAt, id])
  @@map("website_promotional_popups")
}


enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  REVOKED
}

enum EnrollmentSource {
  FREE
  PAID
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum WebhookStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum RefundStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELLED
}

model Enrollment {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @db.Uuid
  courseId         String           @db.Uuid
  orderId          String?          @unique @db.Uuid
  status           EnrollmentStatus @default(ACTIVE)
  source           EnrollmentSource
  enrolledAt       DateTime         @default(now())
  completedAt      DateTime?
  revokedAt        DateTime?
  revocationReason String?          @db.VarChar(120)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  course Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  order  PurchaseOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
  @@index([courseId, status])
  @@index([enrolledAt, id])
  @@map("enrollments")
}

model PurchaseOrder {
  id                    String      @id @default(uuid()) @db.Uuid
  orderNumber           String      @unique @db.VarChar(50)
  userId                String      @db.Uuid
  courseId              String      @db.Uuid
  courseTitleSnapshot   String      @db.VarChar(180)
  currency              String      @db.VarChar(3)
  subtotalMinorUnits    Int
  discountMinorUnits    Int
  totalMinorUnits       Int
  status                OrderStatus @default(PENDING)
  isTestMode            Boolean     @default(true)
  successfulPaymentId   String?     @unique @db.Uuid
  reconciliationReason  String?     @db.VarChar(120)
  paidAt                DateTime?
  expiresAt             DateTime
  cancelledAt           DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  user              User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  course            Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  payments          Payment[]    @relation("OrderAttempts")
  successfulPayment Payment?     @relation("SuccessfulPayment", fields: [successfulPaymentId], references: [id], onDelete: Restrict)
  enrollment        Enrollment?

  @@index([userId, courseId, status])
  @@index([courseId])
  @@index([isTestMode, status, createdAt, id])
  @@map("orders")
}

model Payment {
  id                      String          @id @default(uuid()) @db.Uuid
  orderId                 String          @db.Uuid
  provider                PaymentProvider @default(STRIPE)
  status                  PaymentStatus   @default(PENDING)
  amountMinorUnits        Int
  refundedMinorUnits      Int             @default(0)
  currency                String          @db.VarChar(3)
  isTestMode              Boolean         @default(true)
  stripeCheckoutSessionId String?         @unique @db.VarChar(255)
  stripePaymentIntentId   String?         @unique @db.VarChar(255)
  stripeChargeId          String?         @unique @db.VarChar(255)
  receiptUrl              String?         @db.VarChar(2048)
  idempotencyKey          String          @unique @db.VarChar(255)
  checkoutOrigin          String          @db.VarChar(255)
  failureCode             String?         @db.VarChar(120)
  failureMessage          String?         @db.VarChar(240)
  reconciliationReason    String?         @db.VarChar(120)
  reconciliationVersion   Int             @default(0)
  lastCheckedAt           DateTime?
  paidAt                  DateTime?
  expiresAt               DateTime
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  order           PurchaseOrder   @relation("OrderAttempts", fields: [orderId], references: [id], onDelete: Restrict)
  fulfilledOrder  PurchaseOrder?  @relation("SuccessfulPayment")
  refunds         Refund[]
  disputes        PaymentDispute[]

  @@index([orderId, status])
  @@index([isTestMode, status, createdAt, id])
  @@map("payments")
}

model Refund {
  id            String       @id @default(uuid()) @db.Uuid
  paymentId     String       @db.Uuid
  stripeRefundId String      @unique @db.VarChar(255)
  amountMinorUnits Int
  currency      String       @db.VarChar(3)
  status        RefundStatus
  reason        String?      @db.VarChar(80)
  createdAt     DateTime
  updatedAt     DateTime     @updatedAt
  payment       Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, status])
  @@map("refunds")
}

model PaymentDispute {
  id              String   @id @default(uuid()) @db.Uuid
  paymentId       String   @db.Uuid
  stripeDisputeId String   @unique @db.VarChar(255)
  amountMinorUnits Int
  currency        String   @db.VarChar(3)
  status          String   @db.VarChar(60)
  reason          String   @db.VarChar(80)
  createdAt       DateTime
  updatedAt       DateTime @updatedAt
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("payment_disputes")
}

model WebhookEvent {
  id             String        @id @default(uuid()) @db.Uuid
  stripeEventId  String        @unique @db.VarChar(255)
  eventType      String        @db.VarChar(100)
  stripeObjectId String?       @db.VarChar(255)
  isTestMode     Boolean
  status         WebhookStatus @default(PENDING)
  attempts       Int           @default(0)
  leaseToken     String?       @db.Uuid
  leaseUntil     DateTime?
  lastError      String?       @db.VarChar(100)
  receivedAt     DateTime      @default(now())
  processedAt    DateTime?
  updatedAt      DateTime      @updatedAt

  @@index([status, receivedAt, id])
  @@map("webhook_events")
}

model CheckoutRateLimit {
  userId      String   @id @db.Uuid
  windowStart DateTime
  requests    Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("checkout_rate_limits")
}
